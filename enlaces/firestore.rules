rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Roles: every authenticated account (admin or cajero) has a
    // profile doc at users/{uid}. isAdmin()/isActiveUser() read that
    // doc via get() — that read does not consume the caller's own
    // `read` permission on /users, so it works even for a cajero.
    // ------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && myUser().role == 'admin' && myUser().active != false;
    }
    function isActiveUser() {
      return isSignedIn() && myUser().active != false;
    }
    function diffKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // One-time bootstrap flag: the very first person to sign in (the
    // original admin account created by hand in Firebase Console) is
    // allowed to create their own admin profile exactly once. Once
    // meta/setup exists, that door closes — every user after that can
    // only be created by an existing admin from the Usuarios panel.
    match /meta/setup {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/meta/setup);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/meta/setup));
      allow update: if isAdmin();
      // No client-side delete: disable an account by setting active:false
      // instead (the Auth account itself can only be removed from the
      // Firebase Console or Admin SDK).
      allow delete: if false;
    }

    // Public site config: anyone can read; only admin can write.
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cashier commission rates: any signed-in user can read (cashiers see
    // their own cut in the corte); only admin can change them.
    match /config/commission {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Products: public read (storefront + QR landing page). Admin can
    // change anything (name/price/etc). A signed-in cashier may only
    // touch `stock` (and only downward) — that's the write a sale makes
    // when it deducts inventory; it can never change price or metadata.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isActiveUser()
            && diffKeys().hasOnly(['stock', 'updatedAt'])
            && request.resource.data.stock is number
            && request.resource.data.stock <= resource.data.stock);
    }

    // Inventory movement log: admin manages stock adjustments; cashiers
    // only append the "salida" entry a sale generates. The log itself is
    // append-only — nobody edits or deletes past entries.
    match /inventoryMovements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser();
      allow update, delete: if isAdmin();
    }

    // Cash-register sales. A cashier can only create a sale under their
    // own uid, and can only read their own sales. Admin reads/lists all
    // of them (that's the "corte de caja total"). Voiding a sale is
    // admin-only and may only touch the void fields — never the items,
    // total, or cashier of the original sale.
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.cashierUid == request.auth.uid);
      allow create: if isActiveUser()
        && request.resource.data.cashierUid == request.auth.uid
        && request.resource.data.voided == false;
      allow update: if isAdmin() && diffKeys().hasOnly(['voided', 'voidedAt', 'voidedBy']);
      allow delete: if false;
    }

    // Lock everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
